{
  "name": "desktop-sticky-notes",
  "productName": "Desk notes",
  "version": "0.1.0",
  "description": "Simple offline sticky notes for the Windows desktop.",
  "author": "Phillip Baruth",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "start": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.baruth91.desknote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.cjs",
      "dist/preload.cjs",
      "dist/renderer.js",
      "dist/index.html",
      "dist/styles.css",
      "assets/icon.png",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "desk-notes-${version}-windows-x64.exe"
    }
  }
}
